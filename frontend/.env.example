# Copie para .env.local se precisar mudar algo; nada aqui é obrigatório.

# Backend local para o proxy do Vite (padrão: http://localhost:8000).
# Útil se a API estiver em outra porta, como 8010.
# PONTOA_API_PROXY_TARGET=http://localhost:8010

# URL da API no build. Padrão: /api/v1 no mesmo domínio do frontend.
# VITE_API_URL=https://api.exemplo.com.br/api/v1
