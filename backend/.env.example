# Copie este arquivo para .env e ajuste os valores.
# O arquivo .env nunca deve ser versionado.

PONTOA_ENVIRONMENT=development
PONTOA_DEBUG=false
PONTOA_LOG_LEVEL=INFO
PONTOA_CORS_ORIGINS=["http://localhost:5173"]

# Banco de dados (os mesmos valores do .env da raiz).
# Na sua máquina, o banco do Docker fica em 127.0.0.1:5432.
PONTOA_DATABASE_URL=postgresql+psycopg://pontoa:troque-esta-senha@127.0.0.1:5432/pontoa
PONTOA_TEST_DATABASE_URL=postgresql+psycopg://pontoa:troque-esta-senha@127.0.0.1:5432/pontoa_test

# Duração das sessões de login, em horas (1 a 168).
PONTOA_SESSION_TTL_HOURS=12
